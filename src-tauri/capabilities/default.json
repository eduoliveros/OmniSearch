{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "name": "allow-all-paths-and-urls",
          "path": "**"
        }
      ]
    }
  ]
}
